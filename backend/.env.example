# Copier ce fichier en .env et l'adapter, puis le charger avant de lancer Django
# (par exemple : set -a; source .env; set +a)

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire-de-50-caracteres
DJANGO_DEBUG=0
# Afficher les comptes de démonstration sur la page de connexion (jamais en production réelle)
UMURAGE_DEMO=0
# Obligatoire en production (domaines séparés par des virgules, jamais *)
DJANGO_ALLOWED_HOSTS=umurage.example.org
CORS_ORIGINS=https://umurage.example.org
CSRF_TRUSTED_ORIGINS=https://umurage.example.org
# Nom de domaine public (le proxy Caddy de docker-compose.prod.yml obtient le certificat HTTPS pour lui)
UMURAGE_DOMAINE=umurage.example.org
# Adresse e-mail prévenue par Let's Encrypt avant l'expiration d'un certificat
UMURAGE_EMAIL_TLS=admin@example.org
# Nombre de proxys de confiance devant Django (1 avec Caddy/Nginx/Traefik, 0 sans proxy).
# Déjà fixé à 1 dans docker-compose.prod.yml ; à renseigner seulement pour un déploiement sans Docker.
UMURAGE_NUM_PROXIES=1

# Base PostgreSQL (si absente, SQLite est utilisé)
POSTGRES_DB=umurage
POSTGRES_USER=umurage
POSTGRES_PASSWORD=mot-de-passe-solide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Taux de change de référence et URL publique (utilisée dans les QR codes)
TAUX_USD_BIF=2950
FRONTEND_URL=https://umurage.example.org

# Clé partagée par les capteurs ESP32
IOT_API_KEY=remplacer-par-une-cle-secrete

# LLM optionnel pour l'assistant (API compatible OpenAI, ex. Ollama en local)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=ollama

# WhatsApp Cloud API (Meta) pour la saisie depuis le terrain (facultatif)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=un-mot-secret-de-votre-choix

# Transcription des messages vocaux (facultatif, nécessite : pip install faster-whisper)
WHISPER_MODELE=small

# Messagerie (codes « mot de passe oublié » envoyés par e-mail)
EMAIL_HOST=smtp.exemple.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=UMURAGE <no-reply@exemple.org>

# Liens signés vers les fichiers téléversés : durée de validité en minutes
FICHIERS_LIEN_MINUTES=240

# Journal technique : niveau et fichier tournant facultatif
LOG_NIVEAU=INFO
LOG_FICHIER=

# Suivi des erreurs (Sentry ou GlitchTip auto-hébergé). Laisser vide pour désactiver.
SENTRY_DSN=
SENTRY_ENVIRONNEMENT=production
